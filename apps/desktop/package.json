{
  "name": "@village/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/runtime.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config vite.renderer.config.ts && node ../../scripts/copy-desktop-assets.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@village/contracts": "workspace:*",
    "@village/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "electron": "43.2.0"
  }
}
